#!/usr/bin/env python3
"""structure-check: report what's out of shape in a sphere. Reports; never fixes, never blocks.

Checks every live node of every tree declared in the shapes file: its current-state
and history files exist, and its frontmatter has exactly its tree's keys, in order,
with fixed values and formats where the tree fixes them. Also checks the focus
tree's numbering and parents, and the sphere's .gitattributes and .gitignore lines.
It reads frontmatter and folder listings only, never bodies, so it stays cheap.
Archived nodes (<tree>/archived/) are checked only with --archive or when named.
"""

import argparse
import os
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from sphere_shapes import check_everything, check_node, read_shapes  # noqa: E402


def default_root() -> str:
    """The git top level, else the current folder."""
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else os.getcwd()


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="structure-check",
        description=(__doc__ or "").split("\n\n")[1],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--root", help="the sphere (default: the git top level, else the current folder)")
    parser.add_argument("--shapes", help="the shape declaration (default: core/shapes in the sphere)")
    parser.add_argument(
        "--strict", action="store_true", help="exit 1 when anything is reported (default: always exit 0)"
    )
    parser.add_argument("--archive", action="store_true", help="also check archived nodes (default: live ones only)")
    parser.add_argument("nodes", nargs="*", metavar="NODE", help="check only these node folders or files")
    args = parser.parse_args(argv)

    shapes_path = os.path.abspath(args.shapes) if args.shapes else None
    os.chdir(args.root or default_root())
    shapes_path = shapes_path or "core/shapes"
    if not os.path.isfile(shapes_path):
        print(f"structure-check: no shapes file at {shapes_path} (pass --shapes FILE)", file=sys.stderr)
        return 2
    shapes = read_shapes(shapes_path)

    if args.nodes:
        findings: list[str] = []
        for node in args.nodes:
            node = node[2:] if node.startswith("./") else node
            node = node.rstrip("/")
            tree = shapes.tree_of(node)
            if tree is None:
                findings.append(f"{node}: not in any declared tree")
                print(findings[-1])
                continue
            for finding in check_node(tree, node):
                findings.append(str(finding))
                print(findings[-1])
    else:
        findings = [str(finding) for finding in check_everything(shapes, args.archive)]
        for finding in findings:
            print(finding)
        print("structure-check: clean" if not findings else f"structure-check: {len(findings)} to look at")

    return 1 if args.strict and findings else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
