#!/usr/bin/env python3
"""new-sphere: assemble a runnable sphere from a build, ready for its first conversation.

Copies, in order: the common protocol set (common/core/protocol → core/protocol), the shared
surface and templates (common/surface, common/layers), the build's own files on top
(builds/<build>/, which win where both have a file), and the sphere's tools (scripts/).
A build that says "extends": "<parent>" in its build.json is laid over its parent: the
parent's files first, then its own, which win where both have one.
Then builds the capability manifest from what it copied, so the first window has it.
The lenses a build ships are named in its core/build.json: "all", or a list; a frame comes
with the first lens it names. Nothing is run and nothing is committed: the sphere's own
init does that, in the first conversation.
Standard library only; runs on Python 3.9.
"""

import argparse
import datetime
import json
import os
import shutil
import sys
from collections.abc import Callable
from typing import Optional, cast

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from sphere_protocol import MANIFEST, build_manifest  # noqa: E402

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
COMMON = os.path.join(REPO, "common")
BUILDS = os.path.join(REPO, "builds")
TOOLS = [
    "sphere",
    "structure-check",
    "manifest-check",
    "sphere_shapes.py",
    "sphere_protocol.py",
    "sphere_views.py",
    "shapes",
]
LEFT_IN_REPO = {"README.md"}  # a build's own README describes it in the repo; it doesn't travel


def frontmatter_value(path: str, key: str) -> str:
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().split("\n")
    if not lines or lines[0] != "---":
        return ""
    for line in lines[1:]:
        if line == "---":
            break
        if line.startswith(key + ":"):
            return line[len(key) + 1 :].strip()
    return ""


def first_lens(path: str) -> str:
    value = frontmatter_value(path, "lens").strip("[]")
    return value.split(",")[0].strip()


def copy_tree(source: str, target: str, keep: Optional[Callable[[str], bool]] = None) -> int:
    """Copy every file under source into target; keep(relative_path) says whether to take it."""
    count = 0
    for folder, _, names in os.walk(source):
        for name in names:
            path = os.path.join(folder, name)
            relative = os.path.relpath(path, source)
            if name == ".DS_Store" or (keep and not keep(relative)):
                continue
            destination = os.path.join(target, relative)
            os.makedirs(os.path.dirname(destination), exist_ok=True)
            shutil.copy2(path, destination)
            count += 1
    return count


def build_chain(name: str) -> list[tuple[str, dict[str, object]]]:
    """A build and the builds it extends: [(folder, build.json), …], the build itself first."""
    chain: list[tuple[str, dict[str, object]]] = []
    while name:
        folder = os.path.join(BUILDS, name)
        with open(os.path.join(folder, "core", "build.json"), encoding="utf-8") as handle:
            manifest: dict[str, object] = json.load(handle)
        if any(existing == folder for existing, _ in chain):
            raise SystemExit(f"new-sphere: {name} extends itself, through {chain[0][0]}")
        chain.append((folder, manifest))
        name = str(manifest.get("extends", ""))
    return chain


def main(argv: list[str]) -> int:
    builds = sorted(name for name in os.listdir(BUILDS) if os.path.isdir(os.path.join(BUILDS, name)))
    parser = argparse.ArgumentParser(
        prog="new-sphere",
        description=(__doc__ or "").split("\n\n")[1],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("build", choices=builds, help="the build to start from")
    parser.add_argument("folder", help="where the new sphere goes: a new or empty folder")
    args = parser.parse_args(argv)

    target = os.path.abspath(os.path.expanduser(args.folder))
    if os.path.exists(target) and (not os.path.isdir(target) or os.listdir(target)):
        print(f"new-sphere: {args.folder} already has something in it; pick a new or empty folder", file=sys.stderr)
        return 2
    chain = build_chain(args.build)  # the build itself, then what it extends, and so on
    manifest = chain[0][1]
    declared = next((m["lenses"] for _, m in chain if "lenses" in m), "all")
    lenses: list[str] = [str(name) for name in cast(list[object], declared)] if isinstance(declared, list) else []
    every_lens = not isinstance(declared, list)  # "all", or not said

    protocol = os.path.join(COMMON, "core", "protocol")

    def wanted(relative: str) -> bool:
        if every_lens:
            return True
        if relative.startswith("lenses" + os.sep):
            return os.path.splitext(os.path.basename(relative))[0] in lenses
        if relative.startswith("frames" + os.sep) and relative.endswith(".md"):
            return first_lens(os.path.join(protocol, relative)) in lenses
        return True

    os.makedirs(target, exist_ok=True)
    copied = copy_tree(protocol, os.path.join(target, "core", "protocol"), wanted)
    copied += copy_tree(os.path.join(COMMON, "surface"), os.path.join(target, "surface"))
    copied += copy_tree(os.path.join(COMMON, "layers"), os.path.join(target, "layers"))

    def travels(relative: str) -> bool:
        return relative not in LEFT_IN_REPO

    for build, _ in reversed(chain):  # the furthest parent first; each build's own files win
        copied += copy_tree(build, target, travels)
    scripts = os.path.join(target, "scripts")
    os.makedirs(scripts, exist_ok=True)
    for tool in TOOLS:
        shutil.copy2(os.path.join(REPO, "scripts", tool), os.path.join(scripts, tool))
        copied += 1

    with open(os.path.join(target, MANIFEST), "w", encoding="utf-8") as handle:
        handle.write(build_manifest(os.path.join(target, "core", "protocol"), datetime.date.today().isoformat()))
    copied += 1

    print(f"A new {args.build} sphere ({manifest.get('version', '')}) is in {args.folder}: {copied} files.")
    print("Open that folder in your AI tool and say hello. The first conversation sets it up.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
